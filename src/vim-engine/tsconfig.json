{
  // vim-engine 단독 타입 검사용 설정 (npm run check:vim-engine)
  // DOM 타입 없이 ES2020 만으로 컴파일되어야 브라우저·Node 어디서나 쓸 수 있습니다.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["./*.ts"],
  "exclude": ["./*.test.ts"]
}
